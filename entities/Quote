{
  "name": "Quote",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "ID da organiza\u00e7\u00e3o (tenant)"
    },
    "customer_id": {
      "type": "string",
      "description": "ID do cliente"
    },
    "briefing_id": {
      "type": "string",
      "description": "ID do briefing"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo do or\u00e7amento"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "awaiting_review",
        "approved",
        "sent",
        "rejected",
        "expired"
      ],
      "default": "draft",
      "description": "Status do or\u00e7amento"
    },
    "subtotal": {
      "type": "number",
      "default": 0,
      "description": "Subtotal"
    },
    "discount": {
      "type": "number",
      "default": 0,
      "description": "Desconto"
    },
    "total": {
      "type": "number",
      "default": 0,
      "description": "Total"
    },
    "ai_summary": {
      "type": "string",
      "description": "Resumo da IA"
    },
    "commercial_text": {
      "type": "string",
      "description": "Texto comercial"
    },
    "validity_days": {
      "type": "number",
      "default": 15,
      "description": "Validade em dias"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    },
    "pdf_url": {
      "type": "string",
      "description": "URL do PDF gerado"
    },
    "items": {
      "type": "array",
      "description": "Itens do or\u00e7amento",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "ai_reason": {
            "type": "string"
          },
          "priority": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "title",
    "customer_id"
  ]
}