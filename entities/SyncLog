{
    "name": "SyncLog",
    "type": "object",
    "properties": {
        "organization_id": {
            "type": "string",
            "description": "ID da organiza\u00e7\u00e3o (tenant)"
        },
        "provider": {
            "type": "string",
            "enum": [
                "bling",
                "nuvemshop"
            ],
            "description": "Provedor"
        },
        "status": {
            "type": "string",
            "enum": [
                "success",
                "partial",
                "error",
                "running"
            ],
            "default": "running",
            "description": "Status da sincroniza\u00e7\u00e3o"
        },
        "message": {
            "type": "string",
            "description": "Mensagem de resultado"
        },
        "total_items": {
            "type": "number",
            "default": 0,
            "description": "Total de itens"
        },
        "success_items": {
            "type": "number",
            "default": 0,
            "description": "Itens com sucesso"
        },
        "failed_items": {
            "type": "number",
            "default": 0,
            "description": "Itens com falha"
        },
        "started_at": {
            "type": "string",
            "description": "In\u00edcio da sincroniza\u00e7\u00e3o"
        },
        "finished_at": {
            "type": "string",
            "description": "Fim da sincroniza\u00e7\u00e3o"
        }
    },
    "required": [
        "provider"
    ]
}